{
  "name": "dsh-smartprompt",
  "version": "0.1.0",
  "description": "DSH Web plugin: a Smart Prompt button under the composer that rewrites your draft into a structured prompt using your workspace conventions, then fills it back into the composer.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./icon.svg",
  "meta": {
    "title": "Smart Prompt",
    "description": "Adds a Smart Prompt button under the composer: reads the session workspace conventions and rewrites your draft into a structured prompt, then fills it back into the composer."
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "src/*.js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.2"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "prompt",
    "prompt-engineering",
    "composer",
    "smart-prompt",
    "concise"
  ],
  "scripts": {
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shellpower96/dsh-prompt-optimizer.git"
  },
  "homepage": "https://github.com/shellpower96/dsh-prompt-optimizer#readme",
  "bugs": {
    "url": "https://github.com/shellpower96/dsh-prompt-optimizer/issues"
  }
}
