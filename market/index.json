  "plugins": [
    {
      "name": "dsh-smartprompt",
      "title": { "en": "Smart Prompt", "zh": "智能提示词" },
      "description": {
        "en": "Rewrites a one-line composer draft into a structured prompt grounded in the project documents you declare (AGENTS.md / README.md), then fills it back into the composer. Reads the git branch and the session goal; caps output at 400 characters (Chinese) with boundary-safe trimming; every setting is injected by the caller, so the plugin assumes no project layout.",
        "zh": "把输入框里的一句话草稿改写成结合你自声明项目文档（AGENTS.md / README.md）、git 分支与会话目标的结构化提示词并回填；输出按 400 字上限收口、超长在行边界截断；全部配置由调用方注入，插件不假设任何项目结构。"
      },
      "icon": "icons/dsh-smartprompt.svg",
      "author": "shellpower96",
      "homepage": "https://github.com/shellpower96/dsh-prompt-optimizer#readme",
      "repository": { "url": "https://github.com/shellpower96/dsh-prompt-optimizer" },
